{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ridge",
  "version": "0.1.0",
  "identifier": "com.ridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ridge",
        "width": 320,
        "height": 28,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3RjBGNjFGNzNBQTk2QzAKUldUQWxxcHpIL2J3RjhRZmpYRHNFYjhRUHBGczd5K0VCSmNMalZKcXVMZWVicG4zQlJ0bElJVnMK",
      "endpoints": [
        "https://github.com/mrchshrct/Ridge/releases/latest/download/latest.json"
      ]
    }
  }
}
